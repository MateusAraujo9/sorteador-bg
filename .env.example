# Sem essas variáveis, o app usa um arquivo SQLite local em data/boardgames.db
# (padrão para desenvolvimento — não precisa configurar nada).
#
# Para usar um banco Turso (necessário em hosts sem disco persistente,
# como o plano gratuito do Render), copie este arquivo para .env e preencha:
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Necessário para o e-mail de "esqueci minha senha" funcionar.
# Envio via API HTTP da Brevo (não SMTP — SMTP costuma ser bloqueado em
# hosts free tier como o Render). Crie uma conta grátis em brevo.com,
# verifique um remetente (Settings > Senders) e gere uma API key
# (Settings > SMTP & API > API Keys).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
